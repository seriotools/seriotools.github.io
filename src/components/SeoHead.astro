---
import {
    alternatesFor,
    languageTags,
    pathFor,
    type Locale,
    type PageKey,
} from '../lib/i18n';

interface Props {
    locale: Locale;
    page: PageKey;
    title: string;
    description: string;
    noindex?: boolean;
}

const { locale, page, title, description, noindex = false } = Astro.props;
const fullTitle =
    page === 'home' ? `SerioTools — ${title}` : `${title} | SerioTools`;
const canonical = new URL(pathFor(page, locale), Astro.site);
const image = new URL('/social-card.svg', Astro.site);
const organizationId = new URL('/#organization', Astro.site).href;
const websiteId = new URL('/#website', Astro.site).href;
const jsonLd = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Organization',
            '@id': organizationId,
            name: 'SerioTools',
            url: new URL('/', Astro.site).href,
            logo: new URL('/favicon.svg', Astro.site).href,
        },
        {
            '@type': 'WebSite',
            '@id': websiteId,
            name: 'SerioTools',
            url: new URL('/', Astro.site).href,
            inLanguage: ['en', 'de-DE', 'sl-SI'],
            publisher: { '@id': organizationId },
        },
        {
            '@type': 'WebPage',
            '@id': `${canonical.href}#webpage`,
            url: canonical.href,
            name: fullTitle,
            description,
            inLanguage: languageTags[locale],
            isPartOf: { '@id': websiteId },
        },
    ],
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<meta
    name="theme-color"
    content="#f4f1ea"
    media="(prefers-color-scheme: light)"
/>
<meta
    name="theme-color"
    content="#101820"
    media="(prefers-color-scheme: dark)"
/>
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta
    name="robots"
    content={
        noindex
            ? 'noindex,follow'
            : 'index,follow,max-image-preview:large,max-snippet:-1'
    }
/>
<link rel="canonical" href={canonical} />
{!noindex &&
    alternatesFor(page).map(({ languageTag, path }) => (
        <link
            rel="alternate"
            hreflang={languageTag}
            href={new URL(path, Astro.site)}
        />
    ))}
{!noindex && (
    <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(pathFor(page, 'en'), Astro.site)}
    />
)}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="SerioTools" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content="SerioTools" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={languageTags[locale].replace('-', '_')} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="manifest" href="/site.webmanifest" />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
