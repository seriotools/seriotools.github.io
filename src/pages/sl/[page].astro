---
import PageView from '../../components/PageView.astro';
import { staticPagePaths, type Locale, type PageKey } from '../../lib/i18n';

export function getStaticPaths() {
    return staticPagePaths('sl');
}

const { locale, page } = Astro.props as { locale: Locale; page: PageKey };
---

<PageView {locale} {page} />
