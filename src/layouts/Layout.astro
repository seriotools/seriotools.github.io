---
// Basic site-wide layout with metadata and global styles
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SerioTools',
  description = 'Built with Astro 7 and the BMad Method.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
