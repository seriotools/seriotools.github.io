---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';
import { content } from '../data/content';
import { languageTags, type Locale, type PageKey } from '../lib/i18n';
import '../styles/global.css';

interface Props {
    locale: Locale;
    page: PageKey;
    title: string;
    description: string;
    noindex?: boolean;
}

const { locale, page, title, description, noindex = false } = Astro.props;
const themeBootstrap = `(()=>{try{const t=localStorage.getItem('theme');if(t==='light'||t==='dark'){document.documentElement.dataset.theme=t;document.querySelectorAll('meta[name="theme-color"]').forEach(m=>m.setAttribute('content',t==='dark'?'#101820':'#f4f1ea'))}}catch{}})();`;
---

<!doctype html>
<html lang={languageTags[locale]}>
    <head>
        <SeoHead {locale} {page} {title} {description} {noindex} />
        <script is:inline set:html={themeBootstrap}></script>
    </head>
    <body>
        <a class="skip-link" href="#main">
            {content[locale].skip}
        </a>
        <Header {locale} {page} />
        <main id="main">
            <slot />
        </main>
        <Footer {locale} />
    </body>
</html>
