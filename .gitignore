# ===========================================================================
# seriotools.github.io — Astro 7.2 project
# ===========================================================================

# --- Dependencies -----------------------------------------------------------
node_modules/

# --- Astro build output & generated types -----------------------------------
dist/
.astro/

# --- Environment variables --------------------------------------------------
.env
.env.*
!.env.example
!.env.test

# --- Python (uv) ------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- BMad Method (BMAD) -------------------------------------------------------
# Installer-owned files — regenerate with: npx bmad-method install
_bmad/*
# Keep human-authored team customizations committed
!_bmad/custom/
# Personal overrides stay local (never commit)
_bmad/custom/*.user.toml
# Generated planning/implementation artifacts
_bmad-output/
# Per-run working memory (never commit)
.memlog.md

# --- Logs -------------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# --- Editor / OS ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# --- Misc build / tooling ---------------------------------------------------
coverage/
*.tsbuildinfo
.cache/

# --- VS Code (keep shared workspace settings/extensions) --------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
